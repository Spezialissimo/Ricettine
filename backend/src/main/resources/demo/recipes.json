    {
      "key": "ravioli-ricotta-spinaci",
      "author": "davide",
      "title": "Ravioli di ricotta e spinaci",
      "portions": 4,
      "prepMinutes": 75,
      "cookMinutes": 5,
      "notes": "La sfoglia asciuga in fretta: tieni coperta quella che non usi. I ravioli crudi si congelano bene, distanziati su un vassoio.",
      "visibility": "PUBLIC",
      "published": true,
      "photo": "ravioli",
      "groups": [
        {
          "name": "Per la sfoglia",
          "ingredients": [
            {
              "amount": 300,
              "unit": "g",
              "name": "farina 00",
              "note": null
            },
            {
              "amount": 3,

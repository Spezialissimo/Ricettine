              "note": null
            },
            {
              "amount": null,
              "unit": null,
              "name": "sale",
              "note": "un pizzico"
            }
          ]
        },
        {
          "name": "Per il ripieno",
          "ingredients": [
            {
              "amount": 250,
              "unit": "g",
              "name": "ricotta",
              "note": null
            },
            {
              "amount": 200,
              "unit": "g",
              "name": "spinaci",
              "note": "lessati e strizzati"
            },
            {
              "amount": 50,
              "unit": "g",
              "name": "parmigiano",
              "note": "grattugiato"
            },
            {
              "amount": null,
              "unit": null,
              "name": "noce moscata",
              "note": "q.b."
            },
            {
              "amount": null,
              "unit": null,
              "name": "sale",
              "note": "q.b."
            }
          ]
        },
        {
          "name": "Per condire",
          "ingredients": [
            {
              "amount": 50,
              "unit": "g",
              "name": "burro",
              "note": null
            },
            {
              "amount": 8,
              "unit": "piece",
              "name": "foglie di salvia",
              "note": null
            },
            {
              "amount": null,
              "unit": null,
              "name": "parmigiano",
              "note": "per servire"
            }
          ]
        }
      ],
      "steps": [
        {
          "text": "Impasta la farina con le uova e un pizzico di sale fino a ottenere un panetto liscio. Avvolgilo e lascialo riposare 30 minuti."
        },
        {
          "text": "Stendi la pasta con la macchina per la pasta, passandola più volte e stringendo i rulli a ogni passaggio, fino a ottenere una sfoglia sottile.",
          "photo": "ravioli-1"
        },
        {
          "text": "Strizza bene gli spinaci lessati, tritali e mescolali con la ricotta, il parmigiano, la noce moscata e un pizzico di sale."
        },
        {
          "text": "Metti il ripieno in una tasca da pasticciere e fai tanti mucchietti, a distanza regolare, su una striscia di sfoglia.",
          "photo": "ravioli-2"
        },
        {
          "text": "Ripiega la sfoglia sul ripieno e premi con le dita attorno ai mucchietti, per far uscire l'aria.",
          "photo": "ravioli-3"
        },
        {
          "text": "In alternativa usa lo stampo per ravioli: stendi la sfoglia sullo stampo, riempi le formine, copri con una seconda sfoglia e passa il mattarello per sigillare e tagliare.",
          "photo": "ravioli-4"
        },
        {
          "text": "Taglia i ravioli con la rotella e disponili su un piano infarinato, senza farli toccare.",
          "photo": "ravioli"
        },
        {
          "text": "Cuoci i ravioli in acqua salata che bolle piano per 3-4 minuti, finché vengono a galla. Scolali con una schiumarola."
        },
        {
          "text": "Sciogli il burro con la salvia, condisci i ravioli e servi con altro parmigiano."
        }
      ]
    },
    {
      "key": "insalata-ceci-capra",
      "author": "davide",
      "title": "Insalata di ceci, coriandolo e formaggio di capra",
      "portions": 4,
      "prepMinutes": 30,
      "cookMinutes": 0,
      "notes": "Il coriandolo dà il sapore caratteristico a questa insalata e va usato in abbondanza, molto più di quanto metteresti di solito. Se non ti piace, sostituiscilo con altro prezzemolo. Variante: aggiungi fagioli bianchi o peperoni a pezzetti.",
      "visibility": "PUBLIC",

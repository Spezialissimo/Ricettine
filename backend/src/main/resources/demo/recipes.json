              "note": null
            },
            {
              "amount": 1,
              "unit": "tsp",
              "name": "cannella",
              "note": null
            },
            {
              "amount": 2,
              "unit": "piece",
              "name": "limoni",
              "note": "solo la scorza grattugiata"
            },
            {
              "amount": 5,
              "unit": "tbsp",
              "name": "rum scuro",
              "note": null
            },
            {
              "amount": null,

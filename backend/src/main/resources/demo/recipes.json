    {
      "key": "carbonara",
      "author": "davide",
      "title": "Spaghetti alla carbonara",
      "portions": 4,
      "prepMinutes": 15,
      "cookMinutes": 15,
      "notes": "Niente panna: la cremosità viene dai tuorli, dal pecorino e dall'acqua di cottura. Se vuoi la versione romana più fedele, usa il guanciale al posto della pancetta.",
      "visibility": "PUBLIC",
      "published": true,
      "photo": "carbonara",
      "groups": [
        {
          "name": null,
          "ingredients": [
            {
              "amount": 320,
              "unit": "g",
              "name": "spaghetti",
              "note": null
            },
            {
              "amount": 6,
              "unit": "piece",
              "name": "tuorli",
              "note": null
            },
            {
              "amount": 150,
              "unit": "g",
              "name": "pancetta o guanciale",
              "note": "a dadini"
            },
            {
              "amount": 50,
              "unit": "g",
              "name": "pecorino romano",
              "note": "grattugiato"
            },
            {
              "amount": null,
              "unit": null,
              "name": "sale",
              "note": "q.b."
            },
            {
              "amount": null,
              "unit": null,
              "name": "pepe nero",
              "note": "q.b., macinato al momento"
            }
          ]
        }
      ],
      "steps": [
        {
          "text": "Metti sul fuoco una pentola grande con acqua e portala a bollore."
        },
        {
          "text": "Taglia la pancetta a dadini e falla rosolare in una padella ampia, senza aggiungere grassi, a fuoco medio per circa 5 minuti, finché diventa dorata e croccante. Spegni il fuoco."
        },
        {
          "text": "In una ciotola sbatti i tuorli con una frusta. Tieni vicino il pecorino grattugiato e la pancetta croccante, scolata su carta assorbente.",
          "photo": "carbonara-1"
        },
        {
          "text": "Aggiungi il pecorino ai tuorli e mescola.",
          "photo": "carbonara-2"
        },
        {
          "text": "Prosegui con una generosa macinata di pepe, finché ottieni una crema densa.",
          "photo": "carbonara-3"
        },
        {
          "text": "Sala l'acqua e cuoci gli spaghetti al dente. Scolali tenendo da parte una tazza di acqua di cottura."
        },
        {
          "text": "Trasferisci la pasta nella padella con la pancetta, a fuoco spento. Versa la crema di uova e mescola velocemente, aggiungendo un po' di acqua di cottura alla volta finché la salsa diventa lucida e cremosa.",
          "photo": "carbonara-4"
        },
        {
          "text": "Servi subito, con altro pecorino e pepe.",
          "photo": "carbonara-5"
        }
      ]
    },

            {
              "amount": 50,
              "unit": "g",
              "name": "olive nere denocciolate",
              "note": "tagliate a metà"
            }
          ]
        },
        {
          "name": "Per la pasta",
          "ingredients": [
            {
              "amount": 500,
              "unit": "g",
              "name": "rigatoni",
              "note": null
            },
            {
              "amount": 30,
              "unit": "g",
              "name": "pecorino",
              "note": "a pezzetti"
            }
          ]
        },
        {
          "name": "Per il pesto veloce",
          "ingredients": [
            {
              "amount": 1,
              "unit": "piece",
              "name": "filetto di acciuga",
              "note": "sciacquato"
            },
            {
              "amount": 1,
              "unit": "clove",
              "name": "aglio",
              "note": "schiacciato"
            },
            {
              "amount": 60,
              "unit": "ml",
              "name": "olio d'oliva",
              "note": null
            },
            {
              "amount": 50,
              "unit": "g",
              "name": "foglie di basilico",
              "note": "spezzettate a mano"
            }
          ]
        }
      ],
      "steps": [
        {
          "text": "Scalda un cucchiaio di olio in una padella larga con coperchio. Rosola le rondelle di salsiccia a fuoco medio-alto per 10 minuti, finché sono dorate. Mettile da parte."
        },
        {
          "text": "Nella stessa padella cuoci cipolla e finocchio per 15 minuti, mescolando ogni tanto, finché sono morbidi e caramellati. Se si asciuga troppo aggiungi un cucchiaino di olio."
        },
        {
          "text": "Unisci paprika, aglio e metà dei semi di finocchio e cuoci 2 minuti. Versa il vino e fai sfumare per 30 secondi."
        },
        {
          "text": "Aggiungi i pelati, lo zucchero, 100 ml di acqua, la salsiccia e mezzo cucchiaino di sale. Copri e fai sobbollire per 30 minuti, togliendo il coperchio dopo 10 minuti, finché il sugo si addensa. Spegni, unisci le olive e i semi di finocchio rimasti."
        },
        {
          "text": "Cuoci i rigatoni in acqua salata per 12-14 minuti, al dente. Scolali, rimettili nella pentola con un cucchiaio di olio e dividili nei piatti."
        },
        {
          "text": "Per il pesto frulla tutti gli ingredienti tranne il basilico con un cucchiaio di acqua fino a un composto grossolano, poi aggiungi il basilico e dai un ultimo giro, senza esagerare."
        },
        {
          "text": "Condisci i rigatoni con il ragù, aggiungi un cucchiaio di pesto, il pecorino e le barbe del finocchio tritate. Servi subito."
        }
      ]

[Unit]
Description=Ricettine database backup to S3
Requires=docker.service
After=docker.service ricettine.service
OnFailure=ricettine-backup-failed.service

[Service]
Type=oneshot
WorkingDirectory=/opt/ricettine
Environment=BACKUP_S3_URI=s3://__BACKUPS_BUCKET__/db/
Environment=AWS_DEFAULT_REGION=__REGION__
ExecStart=/opt/ricettine/deploy/backup.sh
